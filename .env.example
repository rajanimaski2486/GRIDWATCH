# GridWatch secrets. Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   # then edit .env in your editor and paste the real values
#
# NVIDIA API key for hosted Nemotron NIMs (build.nvidia.com).
# This is the only one needed to run the NAT workflow.
NVIDIA_API_KEY=nvapi-paste-yours-here

# --- Optional: citizen intake channels -------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DISCORD_TOKEN=

# --- Optional: observability ------------------------------------------------
# Local Phoenix: `phoenix serve`, then http://localhost:6006/v1/traces
PHOENIX_ENDPOINT=

# --- Historical search: OpenSearch (Aiven) ----------------------------------
# Aiven hands you a service URI with credentials embedded — paste it whole:
#   OPENSEARCH_URL=https://avnadmin:PASSWORD@gridwatch-xxxx.aivencloud.com:12345
# Or give the host separately and set user/password below.
OPENSEARCH_URL=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
# Set false only for a local dev cluster with a self-signed cert.
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_INDEX_PREFIX=nyc_

# --- Deployment (see DEPLOY.md) ---------------------------------------------
# Persist incidents across container restarts. Unset = local SQLite file.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Shared secret for state-changing API routes. Unset = open (fine locally).
# SET THIS before exposing a public URL, or anyone can delete your incidents.
GRIDWATCH_TOKEN=

# Comma-separated CORS allowlist. Unset = "*".
ALLOWED_ORIGINS=

# Master kill switch for outbound SMS/alerts. Set false on a public demo.
ALERTS_ENABLED=false

# Background monitor. Off until incident creation goes through the policy gate.
GRIDWATCH_MONITOR=0
